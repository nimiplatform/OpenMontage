{
  "productName": "OpenMontage",
  "version": "0.1.0",
  "identifier": "ai.nimi.apps.openmontage.studio",
  "build": {
    "beforeDevCommand": "pnpm run dev:renderer",
    "beforeBuildCommand": "pnpm run build",
    "devUrl": "http://127.0.0.1:1461",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "title": "OpenMontage",
        "width": 1120,
        "height": 760
      }
    ]
  },
  "bundle": {
    "icon": [
      "icons/icon.png",
      "icons/icon.ico"
    ]
  }
}
